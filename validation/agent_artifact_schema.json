{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:artifact-projection:1",
  "$defs": {
    "meeting_brief_tool_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "request_key"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "request_key": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "meeting_brief_format_tool_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "request_key", "format_name"],
      "dependentRequired": {"previous_artifact_id": ["expected_version"], "expected_version": ["previous_artifact_id"]},
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "request_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "format_name": {"enum": ["MARKDOWN", "PDF", "DOCX", "XLSX", "PPTX"]},
        "previous_artifact_id": {"type": "string", "format": "uuid"},
        "expected_version": {"type": "integer", "minimum": 1}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision", "locator", "classification", "sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "classification": {"const": "SIMULATED"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "run_id", "series_id", "previous_artifact_id", "version", "media_type", "sha256", "size_bytes", "verification_status", "status", "source_refs"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "run_id": {"type": "string", "format": "uuid"},
        "series_id": {"type": "string", "format": "uuid"},
        "previous_artifact_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "version": {"type": "integer", "minimum": 1},
        "goal_revision": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "media_type": {"enum": ["text/markdown", "application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.openxmlformats-officedocument.presentationml.presentation"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "verification_status": {"const": "VERIFIED"},
        "status": {"enum": ["VERIFIED", "PUBLISHED"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "run_id", "version", "sha256", "status", "published_at"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "run_id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "PUBLISHED"},
        "published_at": {"type": "string", "format": "date-time"}
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "artifacts"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/metadata"}}
      }
    },
    "pending_requests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "requests"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "requests": {"type": "array", "items": {"allOf": [
          {"$ref": "#/$defs/request_receipt"},
          {"properties": {"status": {"const": "RECONCILING"}, "artifact": {"type": "null"}}}
        ]}}
      }
    },
    "request_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "request_key", "artifact_id", "status", "artifact"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "request_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["RECONCILING", "RELEASED", "COMPLETED"]},
        "artifact": {"anyOf": [{"$ref": "#/$defs/metadata"}, {"type": "null"}]}
      }
    },
    "version_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "versions"],
      "properties": {
        "series_id": {"type": "string", "format": "uuid"},
        "versions": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact_id", "run_id", "version", "previous_artifact_id", "status", "goal_revision"],
          "properties": {
            "artifact_id": {"type": "string", "format": "uuid"},
            "run_id": {"type": "string", "format": "uuid"},
            "version": {"type": "integer", "minimum": 1},
            "goal_revision": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
            "previous_artifact_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
            "status": {"enum": ["VERIFIED", "PUBLISHED", "REVOKED"]}
          }
        }}
      }
    },
    "task_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "artifacts"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/metadata"}}
      }
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "artifact_id", "run_id", "intent_id", "artifact_version"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_id": {"type": "string", "format": "uuid"},
        "run_id": {"type": "string", "format": "uuid"},
        "intent_id": {"type": "string", "format": "uuid"},
        "artifact_version": {"type": "integer", "minimum": 1}
      }
    }
  }
}
