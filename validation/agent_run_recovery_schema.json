{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:agent-run-recovery:1",
  "$defs": {
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "status", "unknown_reservations"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "status": {"const": "INTERRUPTED"},
        "unknown_reservations": {"type": "integer", "minimum": 0}
      }
    },
    "recheck_request": {
      "type": "object", "additionalProperties": false,
      "required": ["finish_event_id", "request_key"],
      "properties": {
        "finish_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "request_key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}
      }
    },
    "recheck_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "goal_revision", "current_goal_revision", "recheck_revision", "finish_event_id", "completion_state", "blockers", "output_checks", "requirements"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "goal_revision": {"type": "integer", "minimum": 1},
        "current_goal_revision": {"type": "integer", "minimum": 1},
        "recheck_revision": {"type": "integer", "minimum": 0},
        "finish_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "completion_state": {"const": "BLOCKED"},
        "blockers": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "output_checks": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
        "requirements": {"type": "object"}
      }
    }
  }
}
