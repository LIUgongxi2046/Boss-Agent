(version 1)
(deny default)
(allow file-read* (literal "/"))
(allow file-read-metadata (literal "/Users") (literal "/Users/liuhaoxian") (literal "/Users/liuhaoxian/Downloads") (literal "/Users/liuhaoxian/Downloads/我的") (literal "/Users/liuhaoxian/Downloads/我的/AI项目") (literal "/Users/liuhaoxian/Downloads/我的/AI项目/Boss-Agent") (literal "/Users/liuhaoxian/Downloads/我的/AI项目/Boss-Agent/.work") (literal "/Users/liuhaoxian/Downloads/我的/AI项目/Boss-Agent/.work/upgrade2") (literal "/Users/liuhaoxian/Downloads/我的/AI项目/Boss-Agent/.work/upgrade2/u2-01") (literal "/Users/liuhaoxian/Downloads/我的/AI项目/Boss-Agent/validation") (literal "/Users/liuhaoxian/Downloads/我的/AI项目/Boss-Agent/validation/.work"))
(allow file-read-metadata (literal "/Users/liuhaoxian/Downloads/我的/AI项目/Boss-Agent/.work/upgrade2-u2-08-simulated"))
(allow process-fork)
(allow signal (target self))
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow sysctl-read (sysctl-name "kern.ostype") (sysctl-name "kern.osrelease") (sysctl-name "kern.version") (sysctl-name "kern.hostname") (sysctl-name "hw.machine"))
(allow process-exec (subpath (param "VENV_ROOT")) (subpath "/Library/Frameworks/Python.framework"))
(allow file-read* (subpath (param "VENV_ROOT")))
(allow file-read* (subpath (param "FRONTEND_ROOT")))
(allow file-read* file-write* (subpath (param "WORK_ROOT")))
(allow file-read* file-write* (subpath (param "TEMP_ROOT")))
(allow file-read* (subpath "/System") (subpath "/usr/lib") (subpath "/Library/Frameworks/Python.framework"))
(allow file-read* (literal "/private/etc/apache2/mime.types"))
(allow file-read* file-write* (literal "/dev/null") (literal "/dev/urandom"))
(allow network-bind (local ip "localhost:18871"))
(allow network-bind (local ip "localhost:18872"))
(allow network-bind (local ip "localhost:18873"))
(allow network-bind (local ip "localhost:18874"))
(allow network-inbound (local ip "localhost:18871"))
(allow network-inbound (local ip "localhost:18872"))
(allow network-inbound (local ip "localhost:18873"))
(allow network-inbound (local ip "localhost:18874"))
(allow network-outbound (remote ip "localhost:18871"))
(allow network-outbound (remote ip "localhost:18872"))
(allow network-outbound (remote ip "localhost:18873"))
(allow network-outbound (remote ip "localhost:18874"))
