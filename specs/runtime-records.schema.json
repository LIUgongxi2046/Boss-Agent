{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:runtime-records:1.9.0",
  "title": "实际 Runtime 记录及受限读取",
  "$ref": "#/$defs/RuntimeRecordsProjection",
  "$defs": {
    "Identifier": {"type": "string", "minLength": 1},
    "Version": {"type": "string", "pattern": "^[0-9]+$"},
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Usage": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "prompt_cache_hit_tokens": {"type": ["integer", "null"], "minimum": 0},
        "prompt_cache_miss_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "SourceReference": {
      "type": "object", "required": ["source_id", "version"], "additionalProperties": false,
      "properties": {"source_id": {"$ref": "#/$defs/Identifier"}, "version": {"$ref": "#/$defs/Version"}}
    },
    "PromptVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "prompt_id", "prompt_version", "active_version", "source_refs", "content_sha256"],
      "properties": {
        "kind": {"type": "string"}, "prompt_id": {"$ref": "#/$defs/Identifier"},
        "prompt_version": {"$ref": "#/$defs/Version"}, "active_version": {"$ref": "#/$defs/Version"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/SourceReference"}},
        "content_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "MemoryReference": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["memory_id", "version", "confirmation_state", "eligible", "confirmation_authority_checked"],
      "properties": {
        "memory_id": {"$ref": "#/$defs/Identifier"}, "version": {"$ref": "#/$defs/Version"},
        "confirmation_state": {"enum": ["PROPOSED", "CONFIRMED", "SUPERSEDED", "DELETED"]},
        "eligible": {"type": "boolean"}, "confirmation_authority_checked": {"type": "boolean"}
      }
    },
    "RuntimeSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "api_type", "max_tool_rounds", "max_output_tokens", "timeout", "config_sha256"],
      "properties": {
        "provider": {"$ref": "#/$defs/Identifier"}, "model_id": {"$ref": "#/$defs/Identifier"},
        "api_type": {"$ref": "#/$defs/Identifier"}, "max_tool_rounds": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1}, "timeout": {"type": "number", "exclusiveMinimum": 0},
        "config_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "ToolConfiguration": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_id", "schema_sha256", "implementation_sha256", "implementation"],
      "properties": {
        "tool_id": {"$ref": "#/$defs/Identifier"}, "schema_sha256": {"$ref": "#/$defs/Sha256"},
        "implementation_sha256": {"$ref": "#/$defs/Sha256"}, "implementation": {"$ref": "#/$defs/Identifier"}
      }
    },
    "ModelRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["model_request_id", "request_sha256", "tool_config_sha256", "http_status", "response_ids", "usage", "finish_reasons"],
      "properties": {
        "model_request_id": {"$ref": "#/$defs/Identifier"}, "request_sha256": {"$ref": "#/$defs/Sha256"},
        "tool_config_sha256": {"$ref": "#/$defs/Sha256"}, "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "response_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Identifier"}},
        "usage": {"$ref": "#/$defs/Usage"}, "finish_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "BIQueryContext": {
      "type":"object","additionalProperties":false,
      "required":["parameters","previous_query_id","overridden_fields","inherited_fields","parameters_sha256"],
      "properties":{
        "parameters":{"type":"object","not":{"anyOf":[{"required":["question"]},{"required":["envelope"]}]}},
        "previous_query_id":{"type":["string","null"]},
        "overridden_fields":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "inherited_fields":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "parameters_sha256":{"$ref":"#/$defs/Sha256"}
      }
    },
    "MorningContext": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "timezone", "snapshot_sha256", "order_version", "parameters_sha256", "client_request_id"],
      "properties": {
        "date": {"type": "string", "format": "date"}, "timezone": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/Sha256"}, "order_version": {"$ref": "#/$defs/Version"},
        "parameters_sha256": {"$ref": "#/$defs/Sha256"}, "client_request_id": {"type": ["string", "null"]}
      }
    },
    "MorningItemReference": {
      "type": "object", "additionalProperties": false, "required": ["item_id", "object_id", "version", "source_refs"],
      "properties": {
        "item_id": {"$ref": "#/$defs/Identifier"}, "object_id": {"$ref": "#/$defs/Identifier"},
        "version": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["kind", "id", "version"], "properties": {"kind": {"type": "string"}, "id": {"type": "string"}, "version": {"type": ["string", "null"]}}}}
      }
    },
    "ToolResultReference": {
      "type": "object", "additionalProperties": false, "required": ["tool_id", "tool_call_id", "iteration"],
      "properties": {
        "tool_id": {"$ref": "#/$defs/Identifier"}, "tool_call_id": {"$ref": "#/$defs/Identifier"}, "iteration": {"type": "integer", "minimum": 0},
        "query_id": {"$ref": "#/$defs/Identifier"}, "task_id": {"$ref": "#/$defs/Identifier"}, "message_id": {"$ref": "#/$defs/Identifier"},
        "version": {"$ref": "#/$defs/Version"}, "task_version": {"$ref": "#/$defs/Version"},
        "status": {"type": "string"}, "task_status": {"type": "string"}, "authorization_id": {"$ref": "#/$defs/Identifier"},
        "source_type": {"const":"SIMULATED"}, "source_id":{"$ref":"#/$defs/Identifier"},
        "bi_query_context":{"$ref":"#/$defs/BIQueryContext"},
        "date": {"type": "string", "format": "date"}, "timezone": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/Sha256"}, "order_version": {"$ref": "#/$defs/Version"},
        "business_clock": {"type": "string", "format": "date-time"},
        "list_id": {"$ref": "#/$defs/Identifier"}, "list_version": {"$ref": "#/$defs/Version"},
        "item_refs": {"type": "array", "items": {"$ref": "#/$defs/MorningItemReference"}},
        "document_ref": {"$ref": "#/$defs/SourceReference"},
        "definition_versions":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Identifier"}},
        "detail_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Identifier"}},
        "review_sha256":{"$ref":"#/$defs/Sha256"}, "preparation_sha256":{"$ref":"#/$defs/Sha256"},
        "result_sha256":{"$ref":"#/$defs/Sha256"}, "owner_decision_required":{"const":true},
        "source_refs":{"type":"array","items":{"oneOf":[{"type":"object","additionalProperties":false,"required":["source_id","version"],"properties":{"source_id":{"type":"string"},"version":{"type":"string"},"source_sha256":{"$ref":"#/$defs/Sha256"}}},{"type":"object","additionalProperties":false,"required":["source_id","pinned_version","current_version","source_status"],"properties":{"source_id":{"type":"string"},"pinned_version":{"type":["string","null"]},"current_version":{"type":["string","null"]},"source_status":{"type":"string"}}}]}},
        "origin":{"type":"object","additionalProperties":false,"required":["interface_id","origin_entity_type","origin_record_id","origin_version","review_sha256"],"properties":{"interface_id":{"enum":["SI09","SI10"]},"origin_entity_type":{"type":"string"},"origin_record_id":{"type":"string"},"origin_version":{"type":"string"},"review_sha256":{"$ref":"#/$defs/Sha256"}}}
      }
    },
    "RuntimeRun": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "session_id", "request_id", "request_id_source", "chat_id", "turn_id", "namespace", "configuration_version", "configuration_id", "runtime", "prompt_versions", "tool_config_sha256", "tool_configuration", "status", "stop_reason", "started_at", "finished_at", "tool_results", "model_requests", "usage", "cost_total", "price_version", "usage_coverage", "private_body_recorded", "model_completion_observed", "model_behavior_evaluation_passed", "model_attempts_coverage"],
      "dependentRequired": {"dataset_id": ["dataset_version"], "dataset_version": ["dataset_id"]},
      "x-legacy-field-policy": "既有运行记录可能没有dataset_id/dataset_version及memory_reference；缺少表示当时没有记录，不根据当前设置补充历史。当前生产者使用CurrentRuntimeRun。",
      "properties": {
        "run_id": {"$ref": "#/$defs/Identifier"}, "session_id": {"$ref": "#/$defs/Identifier"}, "request_id": {"$ref": "#/$defs/Identifier"},
        "request_id_source": {"enum": ["MESSAGE", "TURN", "SERVER_GENERATED"]}, "chat_id": {"type": ["string", "null"]}, "turn_id": {"type": ["string", "null"]},
        "namespace": {"$ref": "#/$defs/Identifier"}, "dataset_id": {"$ref": "#/$defs/Identifier"}, "dataset_version": {"$ref": "#/$defs/Version"},
        "configuration_version": {"$ref": "#/$defs/Version"}, "configuration_id": {"$ref": "#/$defs/Identifier"},
        "runtime": {"$ref": "#/$defs/RuntimeSnapshot"}, "prompt_versions": {"type": "array", "items": {"$ref": "#/$defs/PromptVersion"}},
        "tool_config_sha256": {"$ref": "#/$defs/Sha256"}, "memory_reference": {"$ref": "#/$defs/MemoryReference"},
        "tool_configuration": {"type": "array", "items": {"$ref": "#/$defs/ToolConfiguration"}},
        "status": {"enum": ["QUEUED", "RUNNING", "WAITING_INPUT", "SUCCEEDED", "FAILED", "CANCELED", "TIMED_OUT"]},
        "stop_reason": {"type": ["string", "null"]}, "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "tool_results": {"type": "array", "items": {"$ref": "#/$defs/ToolResultReference"}},
        "model_requests": {"type": "array", "items": {"$ref": "#/$defs/ModelRequest"}}, "usage": {"$ref": "#/$defs/Usage"},
        "cost_total": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}, "price_version": {"type": ["string", "null"]},
        "usage_coverage": {"enum": ["NOT_OBSERVED", "PARTIAL_OBSERVED_REQUESTS", "COMPLETE_OBSERVED_REQUESTS"]},
        "private_body_recorded": {"const": false}, "model_completion_observed": {"type": "boolean"}, "model_behavior_evaluation_passed": {"type": "boolean"},
        "model_attempts_coverage": {"const": "HTTP_REQUESTS_OBSERVED_ONLY"}, "termination_source": {"const": "CALLER_DEADLINE_EXPIRED"},
        "source_type":{"const":"SIMULATED"},"external_model_invoked":{"const":false},"external_delivery_verified":{"const":false},"feature_id":{"enum":["FC01","FC02","FC03","FC07"]},
        "assignment_context":{"type":"object","additionalProperties":false,"required":["task_id","task_version","review_sha256"],"properties":{"task_id":{"$ref":"#/$defs/Identifier"},"task_version":{"$ref":"#/$defs/Version"},"review_sha256":{"$ref":"#/$defs/Sha256"}}},
        "morning_context": {"$ref": "#/$defs/MorningContext"},
        "bi_query_context":{"type":"array","items":{"$ref":"#/$defs/BIQueryContext"}},
        "bi_readable_query_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Identifier"}},
        "simulated_model_events":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["event_id","state","source_type","request_sha256","usage","cost_total"],"properties":{"event_id":{"type":"string"},"state":{"enum":["REQUESTED","RESPONSE_RECEIVED","FAILED","CANCELED","TIMED_OUT"]},"source_type":{"const":"SIMULATED"},"request_sha256":{"$ref":"#/$defs/Sha256"},"usage":{"type":"null"},"cost_total":{"type":"null"},"finish_reason":{"type":["string","null"]},"tool_call_ids":{"type":"array","items":{"type":"string"}}}}},
        "tool_errors":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["tool_id","tool_call_id","error_type","source_type"],"properties":{"tool_id":{"type":"string"},"tool_call_id":{"type":"string"},"error_type":{"type":"string"},"source_type":{"const":"SIMULATED"}}}},
        "owner_task_links":{"type":"array","maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["task_id","task_version","request_id","preparation_sha256","action"],"properties":{"task_id":{"type":"string"},"task_version":{"type":"string"},"request_id":{"type":"string"},"preparation_sha256":{"$ref":"#/$defs/Sha256"},"action":{"const":"boss.supply_quality.coordinate"}}}}
      },
      "allOf": [{"if": {"properties": {"status": {"enum": ["SUCCEEDED", "FAILED", "CANCELED", "TIMED_OUT"]}}}, "then": {"properties": {"finished_at": {"type": "string", "format": "date-time"}}}}]
    },
    "CurrentRuntimeRun": {
      "allOf": [{"$ref": "#/$defs/RuntimeRun"}, {"required": ["dataset_id", "dataset_version", "memory_reference"]}],
      "description": "当前W2 RuntimeRecorder生产字段；新增记录需要显式保存数据集和可空记忆引用。"
    },
    "RuntimeRecordsQuery": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 128}, "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "dataset_id": {"type": "string", "minLength": 1, "maxLength": 128}, "stop_reason": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["QUEUED", "RUNNING", "WAITING_INPUT", "SUCCEEDED", "FAILED", "CANCELED", "TIMED_OUT"]},
        "started_from": {"type": "string", "format": "date-time"}, "started_until": {"type": "string", "format": "date-time"},
        "cursor_started_at": {"type": "string", "format": "date-time"}, "cursor_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "limit": {"type": "string", "pattern": "^(?:[1-9][0-9]?|100)$"}
      },
      "dependentRequired": {"cursor_run_id": ["cursor_started_at"], "cursor_started_at": ["cursor_run_id"]}
    },
    "RuntimeRecordsProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["projection", "source_type", "namespace", "read_at", "runs", "matched_count", "limit", "next_cursor", "private_body_available_here", "business_mutation_performed"],
      "properties": {
        "projection": {"const": "runtime-records"}, "source_type": {"const": "RUNTIME_RECORD"}, "namespace": {"$ref": "#/$defs/Identifier"},
        "read_at": {"type": "string", "format": "date-time"}, "runs": {"type": "array", "items": {"$ref": "#/$defs/RuntimeRun"}},
        "matched_count": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "next_cursor": {"type": ["object", "null"], "additionalProperties": false, "required": ["cursor_started_at", "cursor_run_id"],
          "properties": {"cursor_started_at": {"type": "string", "format": "date-time"}, "cursor_run_id": {"$ref": "#/$defs/Identifier"}}},
        "private_body_available_here": {"const": false}, "business_mutation_performed": {"const": false}
      }
    }
  }
}
