{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:business-tools:1.7.0",
  "x-base-schema": "selection-probe.json#/io_schema",
  "description": "当前业务工具Schema；继承获准原定义，明确覆盖协调交办的输入与重读字段。由business.SPEC组合为完整Schema并提供给现有ToolRegistry。",
  "$defs": {
    "identifier": {"type": "string", "minLength": 1},
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "owner_id", "execution_namespace", "dataset_id", "dataset_version", "session_id"],
      "properties": {"request_id": {"$ref": "#/$defs/identifier"}, "owner_id": {"$ref": "#/$defs/identifier"}, "execution_namespace": {"$ref": "#/$defs/identifier"}, "dataset_id": {"$ref": "#/$defs/identifier"}, "dataset_version": {"$ref": "#/$defs/identifier"}, "session_id": {"$ref": "#/$defs/identifier"}}
    },
    "assignment_input": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope", "authorization_id", "content_version", "idempotency_key", "coordinator_id", "purpose", "due_at", "timezone", "evidence_requirements", "related_meeting_id", "related_event_ids", "source_refs"],
      "properties": {
        "envelope": {"$ref": "#/$defs/envelope"}, "authorization_id": {"$ref": "#/$defs/identifier"},
        "content_version": {"$ref": "#/$defs/identifier"}, "idempotency_key": {"$ref": "#/$defs/identifier"},
        "coordinator_id": {"$ref": "#/$defs/identifier"}, "purpose": {"type": "string", "minLength": 1},
        "due_at": {"type": "string", "format": "date-time"}, "timezone": {"type": "string", "minLength": 1},
        "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "related_meeting_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "related_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "read_output": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "status", "version", "purpose", "coordinator_id", "due_at", "timezone", "evidence_requirements", "authorization_id", "related_meeting_id", "related_event_ids", "source_refs", "message_ids", "feedback_ids", "completion_authorization_id", "execution_namespace"],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"}, "status": {"enum": ["OPEN", "WAITING_FEEDBACK", "IN_PROGRESS", "WAITING_MATERIAL", "RESULT_SUBMITTED", "COMPLETED_CONFIRMED", "CANCELED"]},
        "version": {"$ref": "#/$defs/identifier"}, "purpose": {"type": "string", "minLength": 1},
        "coordinator_id": {"$ref": "#/$defs/identifier"}, "due_at": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1}, "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "authorization_id": {"$ref": "#/$defs/identifier"}, "related_meeting_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "related_event_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}, "message_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "feedback_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "completion_authorization_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}, "execution_namespace": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
