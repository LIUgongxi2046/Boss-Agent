{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:simulation-query:1.8.0",
  "title": "当前模拟资料查询与独立技术检查",
  "$ref": "#/$defs/Result",
  "$defs": {
    "Identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "Interface": {"enum": ["SI01", "SI02", "SI03", "SI04", "SI05", "SI06", "SI07", "SI08", "SI09", "SI10", "SI11", "SI12", "SI13", "SI14"]},
    "Query": {
      "type": "object", "additionalProperties": false, "required": ["interface_id", "object_ids", "filters"],
      "properties": {
        "interface_id": {"$ref": "#/$defs/Interface"},
        "object_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/Identifier"}},
        "filters": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"},
            "region_id": {"$ref": "#/$defs/Identifier"}, "product_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/Identifier"}},
            "legal_entity_id": {"$ref": "#/$defs/Identifier"}, "customer_id": {"$ref": "#/$defs/Identifier"},
            "material_id": {"$ref": "#/$defs/Identifier"}, "asset_owner_id": {"$ref": "#/$defs/Identifier"}, "cost_owner_id": {"$ref": "#/$defs/Identifier"},
            "ownership_type": {"enum": ["COMPANY", "CUSTOMER", "COOPERATION"]},
            "batch_id": {"$ref": "#/$defs/Identifier"}, "purpose": {"$ref": "#/$defs/Identifier"}, "stage": {"$ref": "#/$defs/Identifier"},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "source_version": {"type": "string", "pattern": "^[0-9]+$"}
          }
        }
      }
    },
    "SourceStatus": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "version", "current_version", "status"],
      "properties": {
        "source_id": {"$ref": "#/$defs/Identifier"}, "version": {"type": ["string", "null"]}, "current_version": {"type": ["string", "null"]},
        "status": {"enum": ["VALID", "RECEIVED", "INCOMPLETE", "CONFLICTED", "SUPERSEDED", "WITHDRAWN", "EXPIRED", "MISSING", "FORBIDDEN", "CHANGED"]}
      }
    },
    "Record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "object_id", "storage_id", "entity_type", "version", "state", "content_state", "data", "source_refs", "business_authorization_granted"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1}, "object_id": {"$ref": "#/$defs/Identifier"}, "storage_id": {"$ref": "#/$defs/Identifier"}, "entity_type": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]}, "state": {"type": ["string", "null"]},
        "content_state": {"enum": ["STORED_RECORD", "NEEDS_REVIEW", "INACTIVE", "METADATA_ONLY"]},
        "data": {"type": ["object", "null"]}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/SourceStatus"}}, "business_authorization_granted": {"const": false}
      }
    },
    "Result": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "dataset_id", "dataset_version", "execution_namespace", "interface_id", "availability", "access", "records", "sources", "missing_fields", "business_as_of", "read_at", "business_actions_performed", "external_retrieval_performed"],
      "properties": {
        "source_type": {"const": "SIMULATED"}, "dataset_id": {"$ref": "#/$defs/Identifier"}, "dataset_version": {"type": "string", "pattern": "^[0-9]+$"},
        "execution_namespace": {"$ref": "#/$defs/Identifier"}, "interface_id": {"$ref": "#/$defs/Interface"},
        "availability": {"enum": ["PARTIAL", "UNAVAILABLE"]}, "access": {"enum": ["BOSS_ONLY", "TECHNICAL_METADATA"]},
        "records": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/Record"}},
        "sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "version"], "additionalProperties": false, "properties": {"source_id": {"$ref": "#/$defs/Identifier"}, "version": {"type": "string"}}}},
        "missing_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "business_as_of": {"type": ["string", "null"], "format": "date-time"}, "read_at": {"type": "string", "format": "date-time"},
        "business_actions_performed": {"const": false}, "external_retrieval_performed": {"const": false}
      },
      "allOf": [{"if": {"properties": {"access": {"const": "TECHNICAL_METADATA"}}}, "then": {"properties": {"sources": {"maxItems": 0}, "records": {"items": {"properties": {"data": {"type": "null"}, "content_state": {"const": "METADATA_ONLY"}, "source_refs": {"maxItems": 0}}}}}}}]
    }
  }
}
