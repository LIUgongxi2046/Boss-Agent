{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:agent-runs:1",
  "$defs": {
    "key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "text": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"},
    "revision": {"type": "integer", "minimum": 0},
    "required_outputs": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["TEXT", "BRIEF", "SOURCE_LIST", "ACTION_DRAFT", "MARKDOWN", "PDF", "DOCX", "XLSX", "PPTX", "BUSINESS_RECEIPT"]}},
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_revision", "state", "required_outputs"],
      "properties": {"goal_revision": {"type": "integer", "minimum": 1}, "state": {"enum": ["CONFIRMED", "PENDING_CONFIRMATION", "UNAVAILABLE"]}, "required_outputs": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/required_outputs"}]}}
    },
    "method_selection": {
      "type": "object", "additionalProperties": false,
      "required": ["sop_id", "version", "content_sha256"],
      "properties": {"sop_id": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "object_scope_reference": {
      "type": "object", "additionalProperties": false, "required": ["entity_type", "object_id", "version", "sha256"],
      "properties": {"entity_type": {"enum": ["task", "metric_detail", "event", "travel_plan", "owner_goals_active", "meeting_context"]}, "object_id": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "object_scope_candidates": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "goal_revision", "selection_allowed", "unavailable_reasons", "objects"],
      "properties": {"run_id": {"$ref": "#/$defs/key"}, "goal_revision": {"type": "integer", "minimum": 1}, "selection_allowed": {"type": "boolean"}, "unavailable_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["RUN_CANCELED", "RUN_STATE_UNAVAILABLE", "GOAL_ALREADY_SELECTED"]}}, "objects": {"type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["entity_type", "object_id", "version", "sha256", "source_refs", "data"],
        "properties": {"entity_type": {"enum": ["task", "metric_detail", "event", "travel_plan", "owner_goals_active", "meeting_context"]}, "object_id": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "version", "sha256"], "properties": {"source_id": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "data": {"type": "object"}}
      }}}
    },
    "object_scope_request": {
      "type": "object", "additionalProperties": false, "required": ["expected_goal_revision", "request_key", "objects"],
      "properties": {"expected_goal_revision": {"type": "integer", "minimum": 1}, "request_key": {"$ref": "#/$defs/key"}, "objects": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/object_scope_reference"}}}
    },
    "object_scope_receipt": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "goal_revision", "request_key", "objects"],
      "properties": {"run_id": {"$ref": "#/$defs/key"}, "goal_revision": {"type": "integer", "minimum": 1}, "request_key": {"$ref": "#/$defs/key"}, "objects": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
        "type": "object", "additionalProperties": false, "required": ["entity_type", "object_id", "version", "sha256", "source_refs"],
        "properties": {"entity_type": {"enum": ["task", "metric_detail", "event", "travel_plan", "owner_goals_active", "meeting_context"]}, "object_id": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "version", "sha256"], "properties": {"source_id": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}
      }}}
    },
    "method_reselection": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_goal_revision", "request_key", "method_selection"],
      "properties": {"expected_goal_revision": {"type": "integer", "minimum": 2}, "request_key": {"$ref": "#/$defs/key"}, "method_selection": {"$ref": "#/$defs/method_selection"}}
    },
    "method_selection_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["sop_id", "name", "version", "content_sha256", "goal_revision", "state"],
      "properties": {"sop_id": {"$ref": "#/$defs/key"}, "name": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "goal_revision": {"type": "integer", "minimum": 1}, "state": {"const": "SELECTED"}}
    },
    "method_reselection_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "goal_revision", "input_id", "request_key", "method_selection"],
      "properties": {"run_id": {"$ref": "#/$defs/key"}, "goal_revision": {"type": "integer", "minimum": 2}, "input_id": {"$ref": "#/$defs/key"}, "request_key": {"$ref": "#/$defs/key"}, "method_selection": {"$ref": "#/$defs/method_selection_projection"}}
    },
    "method_catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "goal_revision", "selection_allowed", "methods"],
      "properties": {
        "run_id": {"$ref": "#/$defs/key"}, "goal_revision": {"type": "integer", "minimum": 1}, "selection_allowed": {"type": "boolean"},
        "methods": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["sop_id", "name", "version", "content_sha256", "status", "reasons", "missing_native_tools", "missing_runtime_tools", "missing_projections"],
          "properties": {
            "sop_id": {"$ref": "#/$defs/key"}, "name": {"$ref": "#/$defs/key"}, "version": {"$ref": "#/$defs/key"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["DISABLED", "METHOD_UNAVAILABLE", "NATIVE_TOOLS_MISSING", "RUNTIME_TOOLS_MISSING", "PROJECTIONS_MISSING"]}},
            "missing_native_tools": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "missing_runtime_tools": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "missing_projections": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}
          }
        }}
      }
    },
    "create": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "goal", "selected_refs", "request_key"],
      "properties": {
        "conversation_id": {"$ref": "#/$defs/key"}, "goal": {"$ref": "#/$defs/text"},
        "selected_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "request_key": {"$ref": "#/$defs/key"}, "required_outputs": {"$ref": "#/$defs/required_outputs"},
        "method_selection": {"$ref": "#/$defs/method_selection"}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "expected_goal_revision", "request_key"],
      "properties": {
        "input": {"$ref": "#/$defs/text"}, "expected_goal_revision": {"$ref": "#/$defs/revision"},
        "request_key": {"$ref": "#/$defs/key"}, "required_outputs": {"$ref": "#/$defs/required_outputs"}
      }
    },
    "cancel": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_revision", "request_key"],
      "properties": {"expected_revision": {"$ref": "#/$defs/revision"}, "request_key": {"$ref": "#/$defs/key"}}
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "status", "revision"],
      "properties": {"run_id": {"$ref": "#/$defs/key"}, "status": {"$ref": "#/$defs/status"}, "revision": {"$ref": "#/$defs/revision"}}
    },
    "input_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "input_seq", "goal_revision"],
      "properties": {"input_id": {"$ref": "#/$defs/key"}, "input_seq": {"type": "integer", "minimum": 1}, "goal_revision": {"type": "integer", "minimum": 1}}
    },
    "request_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["request_key", "operation", "run_id", "outcome", "receipt"],
      "properties": {
        "request_key": {"$ref": "#/$defs/key"}, "run_id": {"$ref": "#/$defs/key"},
        "operation": {"enum": ["create", "inputs", "cancel"]}, "outcome": {"const": "RECORDED"},
        "receipt": {"oneOf": [{"$ref": "#/$defs/receipt"}, {"$ref": "#/$defs/input_receipt"}]}
      },
      "allOf": [
        {"if": {"properties": {"operation": {"const": "inputs"}}}, "then": {"properties": {"receipt": {"$ref": "#/$defs/input_receipt"}}}},
        {"if": {"properties": {"operation": {"enum": ["create", "cancel"]}}}, "then": {"properties": {"receipt": {"$ref": "#/$defs/receipt"}}}}
      ]
    },
    "status": {"enum": ["QUEUED", "RUNNING", "WAITING_INPUT", "WAITING_CONFIRMATION", "CANCEL_REQUESTED", "RECONCILING", "SUCCEEDED", "FAILED", "CANCELED", "INTERRUPTED"]},
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "conversation_id", "goal", "selected_refs", "status", "revision", "goal_revision", "applied_goal_revision", "last_event_seq", "cancel_requested_at", "allowed_actions", "requirements"],
      "properties": {
        "run_id": {"$ref": "#/$defs/key"}, "conversation_id": {"$ref": "#/$defs/key"}, "goal": {"$ref": "#/$defs/text"},
        "selected_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "status": {"$ref": "#/$defs/status"}, "revision": {"$ref": "#/$defs/revision"},
        "goal_revision": {"type": "integer", "minimum": 1}, "applied_goal_revision": {"type": "integer", "minimum": 1},
        "last_event_seq": {"$ref": "#/$defs/revision"}, "cancel_requested_at": {"type": ["string", "null"], "format": "date-time"},
        "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"enum": ["READ_EVENTS", "ADD_INPUT", "CANCEL", "SELECT_METHOD"]}}, "requirements": {"$ref": "#/$defs/requirements"},
        "method_selection": {"$ref": "#/$defs/method_selection_projection"},
        "waiting_input": {"type": "object", "additionalProperties": false, "required": ["event_id", "goal_revision", "question"], "properties": {"event_id": {"$ref": "#/$defs/key"}, "goal_revision": {"type": "integer", "minimum": 1}, "question": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}}}
      }
    },
    "usage_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "root_run_id", "event_id", "seq", "snapshot_revision", "snapshot_final", "requests_used", "known_requests", "request_limit", "usage_state", "known_total_tokens", "total_tokens", "cost", "cost_state", "currency", "lease_epoch"],
      "properties": {
        "run_id": {"$ref": "#/$defs/key"}, "root_run_id": {"$ref": "#/$defs/key"},
        "event_id": {"$ref": "#/$defs/key"}, "seq": {"type": "integer", "minimum": 1},
        "snapshot_revision": {"type": "integer", "minimum": 1}, "snapshot_final": {"const": false},
        "requests_used": {"type": "integer", "minimum": 0}, "known_requests": {"type": "integer", "minimum": 0},
        "request_limit": {"type": "integer", "minimum": 1}, "usage_state": {"enum": ["EMPTY", "COMPLETE", "PARTIAL", "UNKNOWN"]},
        "known_total_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"]}, "cost_state": {"enum": ["KNOWN", "UNKNOWN"]},
        "currency": {"type": ["string", "null"]}, "lease_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "completion_inspection": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "goal_revision", "current_goal_revision", "inspection_revision", "run_revision", "stale", "result_event_id", "finish_event_id", "completion_state", "blockers", "output_checks", "requirements", "brief_section_audits"],
      "properties": {
        "run_id": {"$ref": "#/$defs/key"},
        "goal_revision": {"type": "integer", "minimum": 1},
        "current_goal_revision": {"type": "integer", "minimum": 1},
        "inspection_revision": {"$ref": "#/$defs/revision"},
        "run_revision": {"$ref": "#/$defs/revision"},
        "stale": {"type": "boolean"},
        "result_event_id": {"$ref": "#/$defs/key"},
        "finish_event_id": {"$ref": "#/$defs/key"},
        "completion_state": {"enum": ["BLOCKED", "UNVERIFIED", "PASS"]},
        "blockers": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "output_checks": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["type", "state"], "properties": {"type": {"enum": ["TEXT", "BRIEF", "SOURCE_LIST", "ACTION_DRAFT", "MARKDOWN", "PDF", "DOCX", "XLSX", "PPTX", "BUSINESS_RECEIPT"]}, "state": {"enum": ["RECORD_PRESENT", "FILE_VERIFIED", "NOT_VERIFIED", "MISSING"]}}}},
        "requirements": {"$ref": "#/$defs/requirements"},
        "brief_section_audits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "section_audit"], "properties": {"artifact_id": {"$ref": "#/$defs/key"}, "version": {"type": "integer", "minimum": 1}, "section_audit": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["meeting_id", "meeting_version", "meeting_sha256", "sections", "gaps", "missing_categories", "completion_state"], "additionalProperties": false, "properties": {"meeting_id": {"type": "string"}, "meeting_version": {"type": "string"}, "meeting_sha256": {"type": "string"}, "completion_state": {"enum": ["PASS", "UNVERIFIED", "BLOCKED"]}, "missing_categories": {"type": "array", "items": {"type": "string"}}, "gaps": {"type": "array", "items": {"type": "object", "required": ["kind", "reason"], "additionalProperties": false, "properties": {"kind": {"type": "string"}, "reason": {"type": "string"}, "source_id": {"type": "string"}}}}, "sections": {"type": "array", "items": {"type": "object", "required": ["kind", "status", "reason", "cited_sources"], "additionalProperties": false, "properties": {"kind": {"type": "string"}, "status": {"enum": ["SUPPORTED", "UNVERIFIED_CONTENT", "MISSING_DOMAIN_FIELD", "BLOCKED"]}, "reason": {"type": "string"}, "cited_sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "version", "sha256"], "additionalProperties": false, "properties": {"source_id": {"type": "string"}, "version": {"type": "string"}, "sha256": {"type": "string"}}}}}}}}}]}}}}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "run_id", "trace_id", "failed_step", "completed_refs", "recovery_action"],
      "properties": {
        "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1},
        "run_id": {"type": ["string", "null"]}, "trace_id": {"type": "string", "minLength": 1},
        "failed_step": {"type": "string", "minLength": 1}, "completed_refs": {"type": "array", "items": {"type": "string"}},
        "recovery_action": {"enum": ["READ_CURRENT", "READ_ORIGINAL_RESULT", "SUPPLY_INPUT", "CONFIRM_CURRENT", "RESUME", "CREATE_NEW_RUN", "NONE"]}
      }
    }
  }
}
