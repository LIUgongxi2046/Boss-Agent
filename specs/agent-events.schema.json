{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:agent-events:1",
  "$defs": {
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "run_id", "seq", "type", "occurred_at", "trace_id", "payload_version", "payload"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1},
        "type": {"enum": ["STATUS_CHANGED", "INPUT_RECEIVED", "RUN_STARTED", "INPUT_APPLIED", "TOOL_STARTED", "TOOL_FINISHED", "ARTIFACT_CANDIDATE", "INPUT_REQUIRED", "INTENT_PREPARED", "USAGE_RECORDED", "RESULT_RECORDED", "RUN_FINISHED", "RUN_FAILED"]},
        "occurred_at": {"type": "string", "format": "date-time"}, "trace_id": {"type": "string", "minLength": 1},
        "payload_version": {"const": 1}, "payload": {"type": "object"}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "RESULT_RECORDED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/result_payload"}}}},
                {"if": {"properties": {"type": {"const": "USAGE_RECORDED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/usage_payload"}}}}]
    },
    "usage_payload": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
         "required": ["requests_used", "total_tokens"],
         "properties": {
           "requests_used": {"type": "integer", "minimum": 0},
           "total_tokens": {"type": ["integer", "null"], "minimum": 0}
         }},
        {"type": "object", "additionalProperties": false,
         "required": ["root_run_id", "usage_kind", "snapshot_revision", "snapshot_final", "lease_epoch", "request_limit", "requests_used", "known_requests", "usage_state", "known_total_tokens", "total_tokens", "cost", "cost_state", "currency"],
         "properties": {
           "root_run_id": {"type": "string", "format": "uuid"},
           "usage_kind": {"const": "CUMULATIVE_SNAPSHOT"},
           "snapshot_revision": {"type": "integer", "minimum": 1},
           "snapshot_final": {"const": false},
           "lease_epoch": {"type": "integer", "minimum": 1},
           "request_limit": {"type": "integer", "minimum": 1},
           "requests_used": {"type": "integer", "minimum": 0},
           "known_requests": {"type": "integer", "minimum": 0},
           "usage_state": {"enum": ["EMPTY", "COMPLETE", "PARTIAL", "UNKNOWN"]},
           "known_total_tokens": {"type": "integer", "minimum": 0},
           "total_tokens": {"type": ["integer", "null"], "minimum": 0},
           "cost": {"type": ["number", "null"]},
           "cost_state": {"enum": ["KNOWN", "UNKNOWN"]},
           "currency": {"type": ["string", "null"]}
         }}
      ]
    },
    "result_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "goal_revision", "engine_commit", "dataset_id", "dataset_version", "source_pins", "citations"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"},
        "goal_revision": {"type": "integer", "minimum": 1},
        "engine_commit": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "source_pins": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "version", "content_sha256"], "properties": {"source_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
        "citations": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator"], "properties": {"source_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1, "maxLength": 2000}}}}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["events", "next_seq", "has_more"],
      "properties": {"events": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/event"}}, "next_seq": {"type": "integer", "minimum": 0}, "has_more": {"type": "boolean"}}
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "goal_revision", "result", "citation_checks"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1}, "goal_revision": {"type": "integer", "minimum": 1},
        "result": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/$defs/event"}, {"properties": {"type": {"const": "RESULT_RECORDED"}}}]}]},
        "citation_checks": {"oneOf": [{"type": "null"}, {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator", "locator_verification"], "properties": {"source_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1, "maxLength": 2000}, "locator_verification": {"const": "NOT_VERIFIED"}}}}]}
      }
    }
  }
}
