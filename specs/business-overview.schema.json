{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boss-agent:business-overview:1.1.0",
  "$defs": {
    "Id": {"type":"string","minLength":1,"maxLength":200},
    "Sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "EntryRequestId":{"type":"string","minLength":8,"maxLength":128,"pattern":"^[A-Za-z0-9_.-]+$"},
    "EntryTopic":{"type":["object","null"],"additionalProperties":false,"required":["page_id","use"],"properties":{
      "page_id":{"enum":["F14","F15","F16","F17","F18","F19","F20","F21","F22","F23"]},
      "use":{"enum":[null,"BROILER","EGG","MILK","BEEF"]}}},
    "EntryNativeContext":{"type":"object","additionalProperties":false,"required":["session_id","chat_id"],"properties":{
      "session_id":{"$ref":"#/$defs/Id"},"chat_id":{"$ref":"#/$defs/Id"}}},
    "EntryBoundContext":{"type":["object","null"],"additionalProperties":false,"required":["session_id","chat_id","native_session_created_at"],"properties":{
      "session_id":{"$ref":"#/$defs/Id"},"chat_id":{"$ref":"#/$defs/Id"},"native_session_created_at":{"$ref":"#/$defs/Id"}}},
    "EntryPrepare":{"type":"object","additionalProperties":false,"required":["client_request_id","applied_scope","snapshot_sha256","topic_reference"],"properties":{
      "client_request_id":{"$ref":"#/$defs/EntryRequestId"},"applied_scope":{"$ref":"#/$defs/Scope"},
      "snapshot_sha256":{"$ref":"#/$defs/Sha256"},"topic_reference":{"$ref":"#/$defs/EntryTopic"}}},
    "EntryBind":{"type":"object","additionalProperties":false,"required":["client_request_id","preparation_id","preparation_sha256","chat_id"],"properties":{
      "client_request_id":{"$ref":"#/$defs/EntryRequestId"},"preparation_id":{"$ref":"#/$defs/Id"},
      "preparation_sha256":{"$ref":"#/$defs/Sha256"},"chat_id":{"$ref":"#/$defs/Id"}}},
    "EntrySource":{"type":"object","additionalProperties":false,"required":["kind","id","version","content_sha256","status"],"properties":{
      "kind":{"const":"document"},"id":{"$ref":"#/$defs/Id"},"version":{"type":["string","null"]},
      "content_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"status":{"$ref":"#/$defs/Id"}}},
    "EntryReference":{"type":"object","additionalProperties":false,"required":["kind","id","version"],"properties":{
      "kind":{"const":"document"},"id":{"$ref":"#/$defs/Id"},"version":{"$ref":"#/$defs/Id"}}},
    "EntryReturn":{"type":"object","additionalProperties":false,"required":["page_id","applied_scope","topic_reference","snapshot_sha256"],"properties":{
      "page_id":{"const":"N03"},"applied_scope":{"$ref":"#/$defs/Scope"},"topic_reference":{"$ref":"#/$defs/EntryTopic"},"snapshot_sha256":{"$ref":"#/$defs/Sha256"}}},
    "EntryPreparation":{"type":"object","additionalProperties":false,"required":["source_type","store_reference","preparation_id","client_request_id","preparation_sha256","prepared_at","bound_at","binding_state","context","applied_scope","scope_sha256","topic_reference","topic_sha256","snapshot_sha256","source_references","business_at","return_reference","current_use_verified","business_authorization_granted","business_mutation_performed"],"properties":{
      "source_type":{"const":"RUNTIME_RECORD"},"store_reference":{"type":"string","format":"uuid"},
      "preparation_id":{"$ref":"#/$defs/Id"},"client_request_id":{"$ref":"#/$defs/EntryRequestId"},"preparation_sha256":{"$ref":"#/$defs/Sha256"},
      "prepared_at":{"type":"string","format":"date-time"},"bound_at":{"type":["string","null"],"format":"date-time"},
      "binding_state":{"enum":["PREPARED","BOUND"]},"context":{"$ref":"#/$defs/EntryBoundContext"},
      "applied_scope":{"$ref":"#/$defs/Scope"},"scope_sha256":{"$ref":"#/$defs/Sha256"},"topic_reference":{"$ref":"#/$defs/EntryTopic"},
      "topic_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"snapshot_sha256":{"$ref":"#/$defs/Sha256"},
      "source_references":{"type":"array","items":{"$ref":"#/$defs/EntrySource"}},"business_at":{"type":"string"},
      "return_reference":{"$ref":"#/$defs/EntryReturn"},"current_use_verified":{"type":"boolean"},
      "business_authorization_granted":{"const":false},"business_mutation_performed":{"const":false}}},
    "EntryContext":{"type":"object","additionalProperties":false,"required":["source_type","session_id","chat_id","binding_state","entry","overview","references","current_use_verified","business_authorization_granted","business_mutation_performed"],"properties":{
      "source_type":{"const":"RUNTIME_RECORD"},"session_id":{"$ref":"#/$defs/Id"},"chat_id":{"$ref":"#/$defs/Id"},"binding_state":{"enum":["BOUND","UNBOUND"]},
      "entry":{"anyOf":[{"$ref":"#/$defs/EntryPreparation"},{"type":"null"}]},"overview":{"anyOf":[{"$ref":"#/$defs/View"},{"type":"null"}]},
      "references":{"type":"array","items":{"$ref":"#/$defs/EntryReference"}},"current_use_verified":{"type":"boolean"},
      "business_authorization_granted":{"const":false},"business_mutation_performed":{"const":false}}},
    "EntryReceiptInput":{"type":"object","additionalProperties":false,"required":["client_request_id"],"properties":{"client_request_id":{"$ref":"#/$defs/EntryRequestId"}}},
    "EntryReceipt":{"type":"object","additionalProperties":false,"required":["source_type","client_request_id","outcome","entry","business_authorization_granted","business_mutation_performed"],"properties":{
      "source_type":{"const":"RUNTIME_RECORD"},"client_request_id":{"$ref":"#/$defs/EntryRequestId"},"outcome":{"enum":["RECORDED","NOT_FOUND_IN_CURRENT_STORE"]},
      "entry":{"anyOf":[{"$ref":"#/$defs/EntryPreparation"},{"type":"null"}]},"business_authorization_granted":{"const":false},"business_mutation_performed":{"const":false}}},
    "Scope": {"type":"object","additionalProperties":false,"required":["legal_entity_id","region_id","period_start","period_end","timezone","attention"],"properties":{
      "legal_entity_id":{"$ref":"#/$defs/Id"},"region_id":{"type":["string","null"],"minLength":1},
      "period_start":{"type":"string","format":"date"},"period_end":{"type":"string","format":"date"},"timezone":{"$ref":"#/$defs/Id"},
      "attention":{"enum":["ALL","OWNER_INVOLVEMENT","SOURCE_REVIEW"]}}},
    "Detail":{"type":"object","additionalProperties":false,"required":["scope","page_id","snapshot_sha256"],"properties":{
      "scope":{"$ref":"#/$defs/Scope"},"page_id":{"enum":["F14","F15","F16","F17","F18","F19","F20","F21","F22","F23"]},"snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "Record":{"type":"object","additionalProperties":false,"required":["kind","id","version","state","adoption_state","source_refs","facts"],"properties":{
      "kind":{"$ref":"#/$defs/Id"},"id":{"$ref":"#/$defs/Id"},"version":{"type":["string","null"]},"state":{"type":["string","null"]},
      "adoption_state":{"enum":["CURRENT","NEEDS_REVIEW"]},"source_refs":{"type":"array","items":{"type":"object"}},"facts":{"type":["object","null"]}}},
    "Topic":{"type":"object","additionalProperties":false,"required":["page_id","title","purpose","availability","data_as_of","latest_source_published_at","records","missing_fields","scope_application","related_sales_source_refs","uses"],"properties":{
      "page_id":{"$ref":"#/$defs/Id"},"title":{"type":"string"},"purpose":{"type":"object"},
      "availability":{"enum":["PARTIAL","NEEDS_REVIEW","SOURCE_NOT_AVAILABLE","FILTER_EMPTY"]},
      "data_as_of":{"type":["string","null"]},"latest_source_published_at":{"type":["string","null"]},"records":{"type":"array","items":{"$ref":"#/$defs/Record"}},
      "missing_fields":{"type":"array","items":{"type":"string"}},"scope_application":{"type":"string"},"related_sales_source_refs":{"type":"array","items":{"type":"object"}},"uses":{"type":"array","items":{"type":"string"}}}},
    "View":{"type":"object","additionalProperties":false,"required":["source_type","projection","applied_scope","dimensions","scope_application","metrics","metric_missing_fields","metric_scope","metric_coverage","query_handoff","query_handoff_unavailable_reason","topics","alerts","alert_scope_exclusions","associations","sources","excluded_records","unclassified_records","business_at","read_at","coverage_state","snapshot_sha256","business_authorization_granted","business_mutation_performed"],"properties":{
      "source_type":{"const":"SIMULATED"},"projection":{"const":"business-overview"},"applied_scope":{"$ref":"#/$defs/Scope"},"dimensions":{"type":"object"},"scope_application":{"type":"object"},
      "metrics":{"type":"array","items":{"type":"object","required":["metric_id","value","unit","formula","definition_version","precision","business_as_of","source_refs"],"properties":{"value":{"type":["string","null"]}}}},
      "metric_missing_fields":{"type":"array","items":{"type":"string"}},"metric_scope":{"const":"WATER_FEED_EXTERNAL_SALES_ONLY"},"metric_coverage":{"type":"object","required":["state","missing_region_ids","record_refs"]},"query_handoff":{"type":["object","null"]},"query_handoff_unavailable_reason":{"type":["string","null"]},
      "topics":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/Topic"}},"alerts":{"type":"array","items":{"type":"object"}},
      "associations":{"type":"array","items":{"type":"object"}},"sources":{"type":"array","items":{"type":"object"}},"excluded_records":{"type":"array","items":{"type":"object"}},"unclassified_records":{"type":"array","items":{"type":"object"}},"alert_scope_exclusions":{"type":"object","required":["scope","attention"],"additionalProperties":{"type":"integer","minimum":0}},
      "business_at":{"type":"string"},"read_at":{"type":"string"},"coverage_state":{"const":"PARTIAL"},"snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "business_authorization_granted":{"const":false},"business_mutation_performed":{"const":false}}}
  }
}
