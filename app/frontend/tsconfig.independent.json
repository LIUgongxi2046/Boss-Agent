{
  "extends": "../../vendor/nanobot/webui/tsconfig.build.json",
  "compilerOptions": {
    "baseUrl": "../../vendor/nanobot/webui",
    "paths": {
      "@/boss-agent/*": ["../../../app/webui/*"],
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "qrcode": ["./node_modules/@types/qrcode/index.d.ts"],
      "luxon": ["./node_modules/@types/luxon/index.d.ts"],
      "react-syntax-highlighter": ["./node_modules/@types/react-syntax-highlighter/index.d.ts"],
      "react-syntax-highlighter/*": ["./node_modules/@types/react-syntax-highlighter/*"],
      "react-i18next": ["./node_modules/react-i18next"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@radix-ui/react-dialog": ["./node_modules/@radix-ui/react-dialog"],
      "*": ["./node_modules/*"]
    }
  },
  "include": [
    "../../vendor/nanobot/webui/src",
    "../../vendor/nanobot/nanobot/channels/*/webui/**/*.ts",
    "../../vendor/nanobot/nanobot/channels/*/webui/**/*.tsx"
  ],
  "exclude": ["../../vendor/nanobot/webui/src/tests/**"]
}
