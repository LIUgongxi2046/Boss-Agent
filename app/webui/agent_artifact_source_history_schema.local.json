{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["run_id", "artifact_id", "artifact_version", "artifact_sha256", "source_id", "version", "sha256", "current_version", "historical", "title", "content", "locator", "locator_verification"],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "artifact_id": {"type": "string", "format": "uuid"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "current_version": {"type": "string", "minLength": 1},
    "historical": {"type": "boolean"},
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "locator": {"type": "string", "minLength": 1},
    "locator_verification": {"const": "NOT_VERIFIED"}
  }
}
