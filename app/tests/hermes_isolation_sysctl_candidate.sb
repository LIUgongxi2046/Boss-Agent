(version 1)
(deny default)
(allow process-exec)
(allow signal (target self))
(allow sysctl-read (sysctl-name "hw.cachelinesize" "hw.logicalcpu" "hw.logicalcpu_max"
    "hw.physicalcpu" "hw.physicalcpu_max" "hw.pagesize" "hw.pagesize_compat" "hw.ncpu"
    "hw.memsize" "hw.vectorunit" "hw.optional.avx512bw" "hw.product"
    "kern.osproductversion" "kern.osversion" "kern.ostype" "kern.osrelease" "kern.version" "kern.argmax" "hw.machine"))
(allow file-read-metadata)
(allow file-read* (literal "/"))
(allow file-read*
    (subpath "/System")
    (subpath "/bin")
    (subpath "/sbin")
    (subpath "/usr/bin")
    (subpath "/usr/sbin")
    (subpath "/usr/lib")
    (subpath "/usr/share")
    (subpath "/Library/Frameworks")
    (subpath "/usr/local")
    (subpath "/private/etc")
    (subpath "/private/var/db/timezone")
    (subpath (param "PYTHON_BASE"))
    (subpath (param "RUNTIME"))
    (subpath (param "ENGINE"))
    (subpath (param "VALIDATION"))
    (subpath (param "WORK")))
(allow file-write* (subpath (param "WORK")))
(allow file-read* file-write* (subpath "/dev"))
(allow network-outbound (remote ip (param "ENDPOINT")))
